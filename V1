-- Membuat service Players
local Players = game:GetService("Players")
local debounceTable = {} -- Untuk mencegah duplikasi hitbox

-- Fungsi untuk membuat HIT BOX invisible
local function createInvisibleHitbox(character)
    -- Validasi: pastikan character valid
    if not character or not character.Parent then
        return
    end
    
    -- Cegah duplikasi dengan debounce system
    if debounceTable[character] then
        return
    end
    debounceTable[character] = true
    
    -- Hapus hitbox lama jika ada
    local existingHitbox = character:FindFirstChild("InvisibleHitbox")
    if existingHitbox then
        existingHitbox:Destroy()
    end
    
    -- Buat hitbox baru
    local hitbox = Instance.new("SelectionBox")
    hitbox.Name = "InvisibleHitbox" -- Nama spesifik untuk memudahkan identifikasi
    hitbox.Adornee = character
    hitbox.Size = Vector3.new(10, 10, 10)
    hitbox.Color3 = Color3.new(0, 0, 0)
    hitbox.Transparency = 1 -- Total transparan
    hitbox.LineThickness = 0.01 -- Tipis agar benar-benar tidak terlihat
    hitbox.SurfaceTransparency = 1
    hitbox.SurfaceColor3 = Color3.new(0, 0, 0)
    hitbox.Parent = character
    
    -- Setup debounce cleanup
    local connection
    connection = character.Destroying:Connect(function()
        debounceTable[character] = nil
        if connection then
            connection:Disconnect()
        end
    end)
    
    -- Debug info
    print("✅ HIT BOX invisible dibuat untuk", character.Name)
end

-- Fungsi untuk menghilangkan HIT BOX
local function removeHitbox(character)
    if not character then
        return
    end
    
    local hitbox = character:FindFirstChild("InvisibleHitbox")
    if hitbox then
        hitbox:Destroy()
        print("🗑️ HIT BOX invisible dihapus untuk", character.Name)
    end
    
    -- Bersihkan dari debounce table
    debounceTable[character] = nil
end

-- ===== EVENT HANDLERS =====

-- Event saat player bergabung ke game
Players.PlayerAdded:Connect(function(player)
    -- Event saat player membuat karakter baru (respawn/spawn pertama)
    player.CharacterAdded:Connect(function(character)
        -- Tunggu 0.1 detik untuk memastikan character fully loaded
        task.wait(0.1)
        createInvisibleHitbox(character)
    end)
    
    -- Event saat karakter akan dihapus (sebelum respawn)
    player.CharacterRemoving:Connect(function(character)
        removeHitbox(character)
    end)
end)

-- Event saat player keluar dari game
Players.PlayerRemoving:Connect(function(player)
    local character = player.Character
    if character then
        removeHitbox(character)
    end
end)

-- ===== HANDLE PLAYER YANG SUDAH ADA DI GAME =====

for _, player in ipairs(Players:GetPlayers()) do
    -- Jika player sudah punya karakter
    if player.Character then
        createInvisibleHitbox(player.Character)
    end
    
    -- Setup events untuk player yang sudah ada
    player.CharacterAdded:Connect(function(character)
        task.wait(0.1)
        createInvisibleHitbox(character)
    end)
    
    player.CharacterRemoving:Connect(function(character)
        removeHitbox(character)
    end)
end

-- Notifikasi saat script aktif
print("=========================================")
print("🚀 Script aktif: HIT BOX invisible untuk semua player")
print("=========================================")
