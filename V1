--[[
    ========================================
    HITBOX EXPANDER - EXPLOIT EDITION
    ========================================
    Metode: Expand hitbox MUSUH di client
    Untuk: Synapse X, KRNL, Fluxus, Script-Ware
    Fungsi: Aim assist - musuh punya hitbox lebih besar
    ========================================
--]]

-- =====================================
-- KONFIGURASI
-- =====================================
local CONFIG = {
    HitBoxSize = Vector3.new(10, 10, 10),
    Transparency = 0.7,
    Color = Color3.fromRGB(255, 0, 0),
    Material = Enum.Material.ForceField,
    
    -- Target options
    TargetTeam = false, -- false = hanya musuh
    IncludeLocalPlayer = false, -- JANGAN EXPAND DIRI SENDIRI
    
    -- Visual
    ShowVisual = true,
    UseBoxHandleAdornment = true -- Lebih stabil untuk exploit
}

-- =====================================
-- SERVICES & VARIABLES
-- =====================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Enabled = false
local OriginalSizes = {}
local Visuals = {}
local UpdateConnection = nil

-- =====================================
-- FUNGSI: CEK APAKAH TARGET VALID
-- =====================================
local function isValidTarget(player)
    -- Jangan expand diri sendiri
    if player == LocalPlayer and not CONFIG.IncludeLocalPlayer then
        return false
    end
    
    -- Cek team
    if not CONFIG.TargetTeam then
        if LocalPlayer.Team and player.Team then
            if LocalPlayer.Team == player.Team then
                return false -- Skip teammate
            end
        end
    end
    
    return true
end

-- =====================================
-- FUNGSI: EXPAND SINGLE PART
-- =====================================
local function expandPart(part)
    if not part or not part:IsA("BasePart") then return end
    
    local success = pcall(function()
        -- Save original if not saved
        if not OriginalSizes[part] then
            OriginalSizes[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                Massless = part.Massless
            }
        end
        
        -- Expand the part
        part.Size = CONFIG.HitBoxSize
        part.Transparency = 1 -- Make invisible
        part.CanCollide = false
        part.Massless = true
    end)
    
    return success
end

-- =====================================
-- FUNGSI: CREATE VISUAL BOX
-- =====================================
local function createVisualBox(part)
    if not CONFIG.ShowVisual or not part then return end
    
    pcall(function()
        -- Remove old visual
        if Visuals[part] then
            Visuals[part]:Destroy()
        end
        
        if CONFIG.UseBoxHandleAdornment then
            -- BoxHandleAdornment (lebih stabil)
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "ESP_Hitbox"
            box.Adornee = part
            box.Size = CONFIG.HitBoxSize
            box.Color3 = CONFIG.Color
            box.Transparency = CONFIG.Transparency
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Parent = part
            Visuals[part] = box
        else
            -- Part method (alternative)
            local visualPart = Instance.new("Part")
            visualPart.Name = "HitboxVisual"
            visualPart.Size = CONFIG.HitBoxSize
            visualPart.Color = CONFIG.Color
            visualPart.Transparency = CONFIG.Transparency
            visualPart.Material = CONFIG.Material
            visualPart.CanCollide = false
            visualPart.Anchored = false
            visualPart.Massless = true
            visualPart.CastShadow = false
            
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = part
            weld.Part1 = visualPart
            weld.Parent = visualPart
            
            visualPart.Parent = workspace
            Visuals[part] = visualPart
        end
    end)
end

-- =====================================
-- FUNGSI: REMOVE VISUAL
-- =====================================
local function removeVisual(part)
    if Visuals[part] then
        pcall(function()
            Visuals[part]:Destroy()
            Visuals[part] = nil
        end)
    end
end

-- =====================================
-- FUNGSI: RESTORE PART
-- =====================================
local function restorePart(part)
    if not OriginalSizes[part] then return end
    
    pcall(function()
        local original = OriginalSizes[part]
        part.Size = original.Size
        part.Transparency = original.Transparency
        part.CanCollide = original.CanCollide
        part.Massless = original.Massless
        
        removeVisual(part)
        OriginalSizes[part] = nil
    end)
end

-- =====================================
-- FUNGSI: EXPAND CHARACTER
-- =====================================
local function expandCharacter(character)
    if not character then return end
    
    task.spawn(function()
        pcall(function()
            -- Wait for HumanoidRootPart
            local hrp = character:WaitForChild("HumanoidRootPart", 5)
            if hrp then
                expandPart(hrp)
                createVisualBox(hrp)
            end
        end)
    end)
end

-- =====================================
-- FUNGSI: RESTORE CHARACTER
-- =====================================
local function restoreCharacter(character)
    if not character then return end
    
    pcall(function()
        for _, part in pairs(character:GetChildren()) do
            if OriginalSizes[part] then
                restorePart(part)
            end
        end
    end)
end

-- =====================================
-- FUNGSI: UPDATE ALL CHARACTERS
-- =====================================
local function updateAllCharacters()
    for _, player in pairs(Players:GetPlayers()) do
        if isValidTarget(player) and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Check if needs expansion
                if hrp.Size ~= CONFIG.HitBoxSize then
                    expandPart(hrp)
                end
                
                -- Check if needs visual
                if CONFIG.ShowVisual and not Visuals[hrp] then
                    createVisualBox(hrp)
                end
            end
        end
    end
end

-- =====================================
-- FUNGSI: START UPDATE LOOP
-- =====================================
local function startUpdateLoop()
    if UpdateConnection then return end
    
    UpdateConnection = RunService.Heartbeat:Connect(function()
        if Enabled then
            updateAllCharacters()
        end
    end)
end

-- =====================================
-- FUNGSI: STOP UPDATE LOOP
-- =====================================
local function stopUpdateLoop()
    if UpdateConnection then
        UpdateConnection:Disconnect()
        UpdateConnection = nil
    end
end

-- =====================================
-- FUNGSI: ENABLE HITBOX
-- =====================================
local function enableHitbox()
    -- Expand all current players
    for _, player in pairs(Players:GetPlayers()) do
        if isValidTarget(player) and player.Character then
            expandCharacter(player.Character)
        end
    end
    
    startUpdateLoop()
end

-- =====================================
-- FUNGSI: DISABLE HITBOX
-- =====================================
local function disableHitbox()
    stopUpdateLoop()
    
    -- Restore all
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            restoreCharacter(player.Character)
        end
    end
    
    -- Clear tables
    OriginalSizes = {}
    Visuals = {}
end

-- =====================================
-- FUNGSI: TOGGLE HITBOX
-- =====================================
local function toggleHitbox()
    Enabled = not Enabled
    
    if Enabled then
        enableHitbox()
    else
        disableHitbox()
    end
    
    return Enabled
end

-- =====================================
-- FUNGSI: CREATE GUI
-- =====================================
local function createGUI()
    local success = pcall(function()
        -- Remove existing GUI
        local existing = LocalPlayer.PlayerGui:FindFirstChild("HitboxGUI")
        if existing then existing:Destroy() end
        
        -- Create ScreenGui
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "HitboxGUI"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        
        -- Main Frame
        local frame = Instance.new("Frame")
        frame.Name = "MainFrame"
        frame.Size = UDim2.new(0, 250, 0, 150)
        frame.Position = UDim2.new(0, 20, 0, 20)
        frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        frame.BorderSizePixel = 0
        frame.Active = true
        frame.Draggable = true
        frame.Parent = screenGui
        
        -- Corner
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = frame
        
        -- Stroke
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 0, 0)
        stroke.Thickness = 2
        stroke.Parent = frame
        
        -- Title
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -20, 0, 30)
        title.Position = UDim2.new(0, 10, 0, 10)
        title.BackgroundTransparency = 1
        title.Text = "🎯 HITBOX EXPANDER"
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextSize = 16
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = frame
        
        -- Info Label
        local info = Instance.new("TextLabel")
        info.Name = "InfoLabel"
        info.Size = UDim2.new(1, -20, 0, 40)
        info.Position = UDim2.new(0, 10, 0, 45)
        info.BackgroundTransparency = 1
        info.Text = "📦 Size: 10x10x10\n🎯 Targets: Enemy Only"
        info.TextColor3 = Color3.fromRGB(180, 180, 180)
        info.TextSize = 12
        info.Font = Enum.Font.Gotham
        info.TextXAlignment = Enum.TextXAlignment.Left
        info.TextYAlignment = Enum.TextYAlignment.Top
        info.Parent = frame
        
        -- Status
        local status = Instance.new("TextLabel")
        status.Name = "StatusLabel"
        status.Size = UDim2.new(1, -20, 0, 20)
        status.Position = UDim2.new(0, 10, 0, 90)
        status.BackgroundTransparency = 1
        status.Text = "Status: 🔴 DISABLED"
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
        status.TextSize = 13
        status.Font = Enum.Font.GothamBold
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.Parent = frame
        
        -- Toggle Button
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0, 210, 0, 35)
        button.Position = UDim2.new(0.5, 0, 1, -45)
        button.AnchorPoint = Vector2.new(0.5, 0)
        button.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        button.Text = "ENABLE"
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.TextSize = 14
        button.Font = Enum.Font.GothamBold
        button.BorderSizePixel = 0
        button.Parent = frame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = button
        
        -- Button Click
        button.MouseButton1Click:Connect(function()
            local state = toggleHitbox()
            
            if state then
                button.Text = "DISABLE"
                button.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                status.Text = "Status: 🟢 ENABLED"
                status.TextColor3 = Color3.fromRGB(100, 255, 100)
                stroke.Color = Color3.fromRGB(0, 255, 0)
            else
                button.Text = "ENABLE"
                button.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                status.Text = "Status: 🔴 DISABLED"
                status.TextColor3 = Color3.fromRGB(255, 100, 100)
                stroke.Color = Color3.fromRGB(255, 0, 0)
            end
        end)
        
        screenGui.Parent = LocalPlayer.PlayerGui
    end)
    
    return success
end

-- =====================================
-- EVENT HANDLERS
-- =====================================

-- Player added
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(character)
        if Enabled and isValidTarget(player) then
            task.wait(0.5)
            expandCharacter(character)
        end
    end)
end)

-- Handle existing players
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function(character)
            if Enabled and isValidTarget(player) then
                task.wait(0.5)
                expandCharacter(character)
            end
        end)
    end
end

-- =====================================
-- INITIALIZATION
-- =====================================
local function initialize()
    print("===========================================")
    print("🎯 HITBOX EXPANDER - EXPLOIT EDITION")
    print("===========================================")
    print("✅ Loaded successfully!")
    print("📌 Method: Client-side hitbox expansion")
    print("🎯 Target: Enemy players only")
    print("📦 Size: 10x10x10")
    print("===========================================")
    
    -- Create GUI
    local guiSuccess = createGUI()
    
    if guiSuccess then
        print("✅ GUI created - Click to toggle")
    else
        warn("⚠️ GUI failed - Use toggle via console")
        print("💡 Type: toggleHitbox() to toggle")
    end
    
    -- Make toggle function global for console access
    _G.toggleHitbox = toggleHitbox
    
    print("===========================================")
end

-- Run initialization
initialize()

-- Return functions for external control
return {
    Toggle = toggleHitbox,
    Enable = enableHitbox,
    Disable = disableHitbox,
    IsEnabled = function() return Enabled end
}
