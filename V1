local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")

local screenGui = Instance.new("ScreenGui")
local frame = Instance.new("Frame")
local uiCornerFrame = Instance.new("UICorner")
local textBox = Instance.new("TextBox")
local uiCornerTextBox = Instance.new("UICorner")
local enableButton = Instance.new("TextButton")
local uiCornerEnableButton = Instance.new("UICorner")
local toggleButton = Instance.new("TextButton")
local uiCornerToggleButton = Instance.new("UICorner")

screenGui.Parent = game.CoreGui
frame.Parent = screenGui
textBox.Parent = frame
enableButton.Parent = frame
toggleButton.Parent = frame
uiCornerFrame.Parent = frame
uiCornerTextBox.Parent = textBox
uiCornerEnableButton.Parent = enableButton
uiCornerToggleButton.Parent = toggleButton

frame.Size = UDim2.new(1, 0, 0, 110)
frame.Position = UDim2.new(0.5, -80, 0.5, -447)
frame.BackgroundColor3 = Color3.fromRGB(290, 50, 52)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.ClipsDescendants = true
frame.BackgroundTransparency = 0.2
frame.Visible = true

uiCornerFrame.CornerRadius = UDim.new(0, 10)

toggleButton.Size = UDim2.new(0, 225, 0, 20)
toggleButton.Position = UDim2.new(0, 0, 0, 0)
toggleButton.Text = "▼"
toggleButton.BackgroundColor3 = Color3.fromRGB(100, 193, 80)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

uiCornerToggleButton.CornerRadius = UDim.new(0, 10)

textBox.Size = UDim2.new(0, 126, 0, 25)
textBox.Position = UDim2.new(0, 10, 0, 15)
textBox.Text = "10"
textBox.BackgroundColor3 = Color3.fromRGB(70, 189, 48)
textBox.TextColor3 = Color3.fromRGB(255, 255, 255)

uiCornerTextBox.CornerRadius = UDim.new(0, 10)

enableButton.Size = UDim2.new(0, 140, 0, 55)
enableButton.Position = UDim2.new(0, 1, 0, 55)
enableButton.Text = "Enable Hitbox"
enableButton.BackgroundColor3 = Color3.fromRGB(233, 233, 233)
enableButton.TextColor3 = Color3.fromRGB(255, 255, 255)

uiCornerEnableButton.CornerRadius = UDim.new(0, 10)

_G.HeadSize = tonumber(textBox.Text) or 10
_G.Disabled = true

local playersToModify = {}

local function updatePlayersToModify()
    playersToModify = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(playersToModify, player)
        end
    end
end

textBox.FocusLost:Connect(function()
    local newSize = tonumber(textBox.Text)
    if newSize then
        _G.HeadSize = newSize
    else
        textBox.Text = tostring(_G.HeadSize)
    end
end)

enableButton.MouseButton1Click:Connect(function()
    if _G.Disabled then
        for _, player in ipairs(playersToModify) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local humanoidRootPart = player.Character.HumanoidRootPart
                humanoidRootPart.Size = Vector3.new(2, 2, 50)
                humanoidRootPart.Transparency = 0
                humanoidRootPart.BrickColor = BrickColor.new("Medium stone grey")
                humanoidRootPart.Material = Enum.Material.Plastic
                humanoidRootPart.CanCollide = true
            end
        end
    end
    _G.Disabled = not _G.Disabled
    enableButton.Text = (_G.Disabled and "Enable Hitbox") or "Disable Hitbox"
end)

toggleButton.MouseButton1Click:Connect(function()
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween
    if not _G.Disabled then
        tween = TweenService:Create(frame, tweenInfo, {Size = UDim2.new(1, 160, 0, 20)})
    else
        tween = TweenService:Create(frame, tweenInfo, {Size = UDim2.new(0, 757, 0, 44)})
    end
    tween:Play()
    toggleButton.Text = (not _G.Disabled and "▲") or "▼"
end

RunService.RenderStepped:Connect(function()
    if not _G.Disabled then
        for _, player in ipairs(playersToModify) do
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local humanoidRootPart = player.Character.HumanoidRootPart
                humanoidRootPart.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                humanoidRootPart.Transparency = 0.99
                humanoidRootPart.BrickColor = BrickColor.new("Really blue")
                humanoidRootPart.Material = Enum.Material.Neon
                humanoidRootPart.CanCollide = false
            end
        end
    end
end)

while true do
    updatePlayersToModify()
    wait(1)
end
