--[[
    ========================================
    SCRIPT HIT BOX EXPANDER V2 - FIXED
    ========================================
    Deskripsi: Hitbox expander untuk SEMUA PLAYER
    Fix: Anti-freeze & apply ke semua player di server
    ========================================
--]]

-- =====================================
-- KONFIGURASI
-- =====================================
local CONFIG = {
    HitBoxSize = Vector3.new(10, 10, 10),
    VisualColor = Color3.fromRGB(255, 0, 0),
    Transparency = 0.7,
    Material = Enum.Material.ForceField,
    ShowVisual = true,
    ExpandTeammates = false, -- false = hanya musuh, true = semua player
    ExpandSelf = false -- false = tidak expand diri sendiri
}

-- =====================================
-- VARIABEL GLOBAL
-- =====================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local HitBoxEnabled = false
local ExpandedPlayers = {}
local Connections = {}

-- =====================================
-- FUNGSI: CEK APAKAH PLAYER ADALAH TARGET
-- =====================================
local function isTargetPlayer(player)
    if player == LocalPlayer and not CONFIG.ExpandSelf then
        return false -- Jangan expand diri sendiri
    end
    
    if not CONFIG.ExpandTeammates then
        -- Hanya expand musuh (team berbeda)
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            return false
        end
    end
    
    return true
end

-- =====================================
-- FUNGSI: EXPAND HITBOX PLAYER LAIN
-- =====================================
local function expandPlayerHitBox(player)
    pcall(function()
        if not player or not player.Character then return end
        if not isTargetPlayer(player) then return end
        
        local character = player.Character
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart then return end
        
        -- Simpan info original
        if not ExpandedPlayers[player] then
            ExpandedPlayers[player] = {
                OriginalSize = humanoidRootPart.Size,
                OriginalTransparency = humanoidRootPart.Transparency,
                OriginalCanCollide = humanoidRootPart.CanCollide,
                Character = character
            }
        end
        
        -- PENTING: Set properties untuk avoid freeze
        humanoidRootPart.Size = CONFIG.HitBoxSize
        humanoidRootPart.Transparency = 0.9 -- Hampir invisible
        humanoidRootPart.CanCollide = false -- PENTING: Avoid collision freeze
        humanoidRootPart.Massless = true -- Tidak pengaruhi physics
        
        -- Buat visual jika enabled
        if CONFIG.ShowVisual then
            createVisualBox(character, humanoidRootPart, player)
        end
    end)
end

-- =====================================
-- FUNGSI: BUAT VISUAL BOX
-- =====================================
local function createVisualBox(character, rootPart, player)
    pcall(function()
        -- Cek apakah sudah ada visual
        local existingVisual = character:FindFirstChild("HitBoxVisual_" .. player.Name)
        if existingVisual then
            existingVisual:Destroy()
        end
        
        -- Buat visual part
        local visualPart = Instance.new("Part")
        visualPart.Name = "HitBoxVisual_" .. player.Name
        visualPart.Size = CONFIG.HitBoxSize
        visualPart.Color = CONFIG.VisualColor
        visualPart.Transparency = CONFIG.Transparency
        visualPart.Material = CONFIG.Material
        visualPart.CanCollide = false
        visualPart.Anchored = false
        visualPart.Massless = true
        visualPart.CastShadow = false
        
        -- Weld ke root part
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rootPart
        weld.Part1 = visualPart
        weld.Parent = visualPart
        
        visualPart.Parent = character
    end)
end

-- =====================================
-- FUNGSI: RESTORE PLAYER HITBOX
-- =====================================
local function restorePlayerHitBox(player)
    pcall(function()
        if not ExpandedPlayers[player] then return end
        
        local data = ExpandedPlayers[player]
        local character = player.Character
        
        if character then
            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                humanoidRootPart.Size = data.OriginalSize
                humanoidRootPart.Transparency = data.OriginalTransparency
                humanoidRootPart.CanCollide = data.OriginalCanCollide
            end
            
            -- Hapus visual
            local visual = character:FindFirstChild("HitBoxVisual_" .. player.Name)
            if visual then
                visual:Destroy()
            end
        end
        
        ExpandedPlayers[player] = nil
    end)
end

-- =====================================
-- FUNGSI: EXPAND SEMUA PLAYER
-- =====================================
local function expandAllPlayers()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer or CONFIG.ExpandSelf then
            if player.Character then
                expandPlayerHitBox(player)
            end
        end
    end
end

-- =====================================
-- FUNGSI: RESTORE SEMUA PLAYER
-- =====================================
local function restoreAllPlayers()
    for player, _ in pairs(ExpandedPlayers) do
        restorePlayerHitBox(player)
    end
end

-- =====================================
-- FUNGSI: TOGGLE HITBOX
-- =====================================
local function toggleHitBox()
    HitBoxEnabled = not HitBoxEnabled
    
    if HitBoxEnabled then
        expandAllPlayers()
        startMaintainLoop()
    else
        restoreAllPlayers()
        stopMaintainLoop()
    end
    
    return HitBoxEnabled
end

-- =====================================
-- FUNGSI: MAINTAIN HITBOX LOOP
-- =====================================
function startMaintainLoop()
    if Connections.MaintainLoop then return end
    
    Connections.MaintainLoop = RunService.Heartbeat:Connect(function()
        if not HitBoxEnabled then return end
        
        for _, player in pairs(Players:GetPlayers()) do
            if isTargetPlayer(player) and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Size ~= CONFIG.HitBoxSize then
                    expandPlayerHitBox(player)
                end
            end
        end
    end)
end

function stopMaintainLoop()
    if Connections.MaintainLoop then
        Connections.MaintainLoop:Disconnect()
        Connections.MaintainLoop = nil
    end
end

-- =====================================
-- FUNGSI: HANDLE PLAYER ADDED
-- =====================================
local function onPlayerAdded(player)
    -- Handle character saat player join
    player.CharacterAdded:Connect(function(character)
        if HitBoxEnabled then
            task.wait(0.5) -- Delay untuk stabilitas
            expandPlayerHitBox(player)
        end
    end)
    
    -- Handle jika character sudah ada
    if player.Character and HitBoxEnabled then
        task.wait(0.5)
        expandPlayerHitBox(player)
    end
end

-- =====================================
-- FUNGSI: HANDLE PLAYER REMOVING
-- =====================================
local function onPlayerRemoving(player)
    restorePlayerHitBox(player)
end

-- =====================================
-- FUNGSI: MEMBUAT GUI
-- =====================================
local function createGUI()
    pcall(function()
        -- Hapus GUI lama
        local existingGui = LocalPlayer.PlayerGui:FindFirstChild("HitBoxGUI")
        if existingGui then existingGui:Destroy() end
        
        -- Buat ScreenGui
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "HitBoxGUI"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        
        -- Frame utama
        local mainFrame = Instance.new("Frame")
        mainFrame.Name = "MainFrame"
        mainFrame.Size = UDim2.new(0, 240, 0, 140)
        mainFrame.Position = UDim2.new(0, 20, 0, 20)
        mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        mainFrame.BorderSizePixel = 0
        mainFrame.Parent = screenGui
        
        -- UICorner
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = mainFrame
        
        -- UIStroke (border)
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 0, 0)
        stroke.Thickness = 2
        stroke.Parent = mainFrame
        
        -- Title
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -20, 0, 30)
        title.Position = UDim2.new(0, 10, 0, 5)
        title.BackgroundTransparency = 1
        title.Text = "🎯 HITBOX EXPANDER V2"
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextSize = 14
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = mainFrame
        
        -- Status
        local status = Instance.new("TextLabel")
        status.Name = "Status"
        status.Size = UDim2.new(1, -20, 0, 20)
        status.Position = UDim2.new(0, 10, 0, 35)
        status.BackgroundTransparency = 1
        status.Text = "📦 Size: 10x10x10"
        status.TextColor3 = Color3.fromRGB(150, 150, 150)
        status.TextSize = 11
        status.Font = Enum.Font.Gotham
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.Parent = mainFrame
        
        -- Players Count
        local playersCount = Instance.new("TextLabel")
        playersCount.Name = "PlayersCount"
        playersCount.Size = UDim2.new(1, -20, 0, 20)
        playersCount.Position = UDim2.new(0, 10, 0, 55)
        playersCount.BackgroundTransparency = 1
        playersCount.Text = "👥 Targets: 0"
        playersCount.TextColor3 = Color3.fromRGB(150, 150, 150)
        playersCount.TextSize = 11
        playersCount.Font = Enum.Font.Gotham
        playersCount.TextXAlignment = Enum.TextXAlignment.Left
        playersCount.Parent = mainFrame
        
        -- Toggle Button
        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 200, 0, 45)
        toggleBtn.Position = UDim2.new(0.5, 0, 0, 85)
        toggleBtn.AnchorPoint = Vector2.new(0.5, 0)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        toggleBtn.Text = "❌ DISABLED"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleBtn.TextSize = 15
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.BorderSizePixel = 0
        toggleBtn.Parent = mainFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = toggleBtn
        
        -- Update players count
        local function updateCount()
            local count = 0
            for _, player in pairs(Players:GetPlayers()) do
                if isTargetPlayer(player) then
                    count = count + 1
                end
            end
            playersCount.Text = "👥 Targets: " .. count
        end
        
        -- Button click
        toggleBtn.MouseButton1Click:Connect(function()
            local enabled = toggleHitBox()
            
            if enabled then
                toggleBtn.Text = "✅ ENABLED"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
                status.Text = "📦 Size: 10x10x10 | 🟢 ACTIVE"
                status.TextColor3 = Color3.fromRGB(0, 255, 0)
                stroke.Color = Color3.fromRGB(0, 255, 0)
            else
                toggleBtn.Text = "❌ DISABLED"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
                status.Text = "📦 Size: 10x10x10"
                status.TextColor3 = Color3.fromRGB(150, 150, 150)
                stroke.Color = Color3.fromRGB(255, 0, 0)
            end
            
            updateCount()
        end)
        
        -- Draggable
        local dragging, dragInput, dragStart, startPos
        
        mainFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = mainFrame.Position
            end
        end)
        
        mainFrame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
        
        -- Update count setiap detik
        spawn(function()
            while screenGui.Parent do
                updateCount()
                task.wait(1)
            end
        end)
        
        screenGui.Parent = LocalPlayer.PlayerGui
    end)
end

-- =====================================
-- FUNGSI: CLEANUP
-- =====================================
local function cleanup()
    pcall(function()
        stopMaintainLoop()
        restoreAllPlayers()
        
        for _, conn in pairs(Connections) do
            if conn then conn:Disconnect() end
        end
        Connections = {}
        
        local gui = LocalPlayer.PlayerGui:FindFirstChild("HitBoxGUI")
        if gui then gui:Destroy() end
    end)
end

-- =====================================
-- INISIALISASI
-- =====================================
local function initialize()
    pcall(function()
        print("========================================")
        print("🎯 HITBOX EXPANDER V2 - FIXED")
        print("========================================")
        print("✅ No Freeze Issue")
        print("✅ Expand All Players")
        print("✅ Size: 10x10x10")
        print("========================================")
        
        -- Buat GUI
        createGUI()
        
        -- Setup existing players
        for _, player in pairs(Players:GetPlayers()) do
            onPlayerAdded(player)
        end
        
        -- Handle new players
        Connections.PlayerAdded = Players.PlayerAdded:Connect(onPlayerAdded)
        Connections.PlayerRemoving = Players.PlayerRemoving:Connect(onPlayerRemoving)
        
        -- Cleanup on exit
        game:GetService("Players").PlayerRemoving:Connect(function(player)
            if player == LocalPlayer then
                cleanup()
            end
        end)
        
        print("✅ Script loaded successfully!")
        print("📌 Toggle button to activate")
    end)
end

-- =====================================
-- JALANKAN
-- =====================================
initialize()
