local function getPlayerByName(name)
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if string.lower(player.Name) == string.lower(name) or 
           (player.DisplayName and string.lower(player.DisplayName) == string.lower(name)) then
            return player
        end
    end
    return nil
end

local espStorage = {}

local function createESP(player)
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local isFriend = false
    for _, friendName in ipairs(_G.FriendList) do
        if string.lower(player.Name) == string.lower(friendName) or
           (player.DisplayName and string.lower(player.DisplayName) == string.lower(friendName)) then
            isFriend = true
            break
        end
    end
    
    if isFriend then
        return
    end
    
    if espStorage[player.Name] then
        return
    end
    
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    
    if not hrp or not humanoid then
        return
    end
    
    local espFolder = Instance.new("Folder")
    espFolder.Name = "ESP_" .. player.Name
    espFolder.Parent = char
    
    local function createLine(name, attachment0Name, attachment1Name)
        local line = Instance.new("LineHandleAdornment")
        line.Name = name
        line.Color3 = Color3.fromRGB(255, 255, 255)
        line.Thickness = 2
        line.Transparency = 0
        line.ZIndex = 1
        line.AlwaysOnTop = true
        line.Adornee = hrp
        
        local att0 = char:FindFirstChild(attachment0Name, true)
        local att1 = char:FindFirstChild(attachment1Name, true)
        
        if att0 and att1 then
            line.Attachment0 = att0
            line.Attachment1 = att1
        end
        
        line.Parent = espFolder
        return line
    end
    
    local head = char:FindFirstChild("Head")
    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
    local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    
    if head and torso then
        local headAtt = Instance.new("Attachment", head)
        headAtt.Name = "HeadAtt"
        headAtt.Position = Vector3.new(0, 0, 0)
        
        local torsoAtt = Instance.new("Attachment", torso)
        torsoAtt.Name = "TorsoTopAtt"
        torsoAtt.Position = Vector3.new(0, 1, 0)
        
        createLine("HeadToTorso", "HeadAtt", "TorsoTopAtt")
    end
    
    if torso then
        local torsoTop = Instance.new("Attachment", torso)
        torsoTop.Name = "TorsoTop"
        torsoTop.Position = Vector3.new(0, 1, 0)
        
        local torsoBottom = Instance.new("Attachment", torso)
        torsoBottom.Name = "TorsoBottom"
        torsoBottom.Position = Vector3.new(0, -1, 0)
        
        createLine("TorsoLine", "TorsoTop", "TorsoBottom")
    end
    
    if torso and leftArm then
        local torsoLeft = Instance.new("Attachment", torso)
        torsoLeft.Name = "TorsoLeft"
        torsoLeft.Position = Vector3.new(-1, 0.5, 0)
        
        local leftArmAtt = Instance.new("Attachment", leftArm)
        leftArmAtt.Name = "LeftArmAtt"
        leftArmAtt.Position = Vector3.new(0, 0.5, 0)
        
        createLine("LeftArmLine", "TorsoLeft", "LeftArmAtt")
    end
    
    if torso and rightArm then
        local torsoRight = Instance.new("Attachment", torso)
        torsoRight.Name = "TorsoRight"
        torsoRight.Position = Vector3.new(1, 0.5, 0)
        
        local rightArmAtt = Instance.new("Attachment", rightArm)
        rightArmAtt.Name = "RightArmAtt"
        rightArmAtt.Position = Vector3.new(0, 0.5, 0)
        
        createLine("RightArmLine", "TorsoRight", "RightArmAtt")
    end
    
    if torso and leftLeg then
        local torsoBottomLeft = Instance.new("Attachment", torso)
        torsoBottomLeft.Name = "TorsoBottomLeft"
        torsoBottomLeft.Position = Vector3.new(-0.5, -1, 0)
        
        local leftLegAtt = Instance.new("Attachment", leftLeg)
        leftLegAtt.Name = "LeftLegAtt"
        leftLegAtt.Position = Vector3.new(0, 0.5, 0)
        
        createLine("LeftLegLine", "TorsoBottomLeft", "LeftLegAtt")
    end
    
    if torso and rightLeg then
        local torsoBottomRight = Instance.new("Attachment", torso)
        torsoBottomRight.Name = "TorsoBottomRight"
        torsoBottomRight.Position = Vector3.new(0.5, -1, 0)
        
        local rightLegAtt = Instance.new("Attachment", rightLeg)
        rightLegAtt.Name = "RightLegAtt"
        rightLegAtt.Position = Vector3.new(0, 0.5, 0)
        
        createLine("RightLegLine", "TorsoBottomRight", "RightLegAtt")
    end
    
    espStorage[player.Name] = espFolder
end

local function removeESP(player)
    if espStorage[player.Name] then
        espStorage[player.Name]:Destroy()
        espStorage[player.Name] = nil
    end
    
    if player.Character then
        local existingESP = player.Character:FindFirstChild("ESP_" .. player.Name)
        if existingESP then
            existingESP:Destroy()
        end
    end
end

local function updateAllESP()
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player ~= game:GetService("Players").LocalPlayer then
            removeESP(player)
            if _G.ESPEnabled then
                createESP(player)
            end
        end
    end
end

