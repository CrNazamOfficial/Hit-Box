        if #_G.FriendList >= _G.MaxFriends then
            nicknameBox.Text = "MAX FRIENDS REACHED!"
            nicknameBox.TextColor3 = Color3.fromRGB(255, 50, 50)
            wait(1)
            nicknameBox.Text = ""
            nicknameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            return
        end
        
        for _, friendName in ipairs(_G.FriendList) do
            if string.lower(friendName) == string.lower(name) then
                nicknameBox.Text = "ALREADY IN LIST!"
                nicknameBox.TextColor3 = Color3.fromRGB(255, 50, 50)
                wait(1)
