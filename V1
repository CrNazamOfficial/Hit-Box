-- =====================================
-- KONFIGURASI
-- =====================================
local CONFIG = {
    HitBoxSize = Vector3.new(25, 25, 25),
    Transparency = 0.6,
    Color = Color3.fromRGB(255, 50, 50),
    
    -- Target
    TargetTeam = false,  -- false = musuh only
    IncludeLocalPlayer = false,  -- JANGAN expand diri sendiri
    
    -- Visual
    ShowVisual = true,
    
    -- Performance
    UpdateRate = 0.1  -- Update setiap 0.1 detik
}

-- =====================================
-- SERVICES
-- =====================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- =====================================
-- VARIABLES
-- =====================================
local Enabled = false
local OriginalSizes = {}
local Visuals = {}
local Connections = {}
local LastCleanup = tick()

-- =====================================
-- UTILITY FUNCTIONS
-- =====================================
local function isValidTarget(player)
    if not player or player == LocalPlayer then
        return false
    end
    
    if not player:IsDescendantOf(Players) then
        return false
    end
    
    -- Team check
    if not CONFIG.TargetTeam then
        if LocalPlayer.Team and player.Team then
            if LocalPlayer.Team == player.Team then
                return false
            end
        end
    end
    
    return true
end

-- =====================================
-- EXPAND FUNCTIONS
-- =====================================
local function expandPart(part)
    if not part or not part:IsA("BasePart") then return false end
    if not part.Parent then return false end
    
    local success = pcall(function()
        -- Save original
        if not OriginalSizes[part] then
            OriginalSizes[part] = {
                Size = part.Size,
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                Massless = part.Massless
            }
        end
        
        -- Expand
        part.Size = CONFIG.HitBoxSize
        part.Transparency = 1
        part.CanCollide = false
        part.Massless = true
    end)
    
    return success
end

local function createVisual(part)
    if not CONFIG.ShowVisual or not part then return end
    
    pcall(function()
        -- Remove old
        if Visuals[part] then
            Visuals[part]:Destroy()
        end
        
        -- Create new
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "HitboxESP"
        box.Adornee = part
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = CONFIG.HitBoxSize
        box.Transparency = CONFIG.Transparency
        box.Color3 = CONFIG.Color
        box.Parent = part
        
        Visuals[part] = box
    end)
end

local function removeVisual(part)
    if Visuals[part] then
        pcall(function()
            Visuals[part]:Destroy()
            Visuals[part] = nil
        end)
    end
end

local function restorePart(part)
    if not OriginalSizes[part] then return end
    
    pcall(function()
        if part and part.Parent then
            local original = OriginalSizes[part]
            part.Size = original.Size
            part.Transparency = original.Transparency
            part.CanCollide = original.CanCollide
            part.Massless = original.Massless
        end
        
        removeVisual(part)
        OriginalSizes[part] = nil
    end)
end

-- =====================================
-- CHARACTER FUNCTIONS
-- =====================================
local function expandCharacter(character)
    if not character then return end
    
    task.spawn(function()
        local hrp = character:WaitForChild("HumanoidRootPart", 5)
        if hrp and expandPart(hrp) then
            createVisual(hrp)
        end
    end)
end

local function restoreCharacter(character)
    if not character then return end
    
    pcall(function()
        for _, part in pairs(character:GetChildren()) do
            if OriginalSizes[part] then
                restorePart(part)
            end
        end
    end)
end

-- =====================================
-- UPDATE LOOP
-- =====================================
local LastUpdate = 0

local function updateAllHitboxes()
    if not Enabled then return end
    
    local now = tick()
    if now - LastUpdate < CONFIG.UpdateRate then return end
    LastUpdate = now
    
    -- Update all players
    for _, player in pairs(Players:GetPlayers()) do
        if isValidTarget(player) and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if hrp and hrp.Parent then
                -- Check if needs expansion
                if hrp.Size ~= CONFIG.HitBoxSize then
                    expandPart(hrp)
                end
                
                -- Check visual
                if CONFIG.ShowVisual then
                    if not Visuals[hrp] or not Visuals[hrp].Parent then
                        createVisual(hrp)
                    end
                end
            end
        end
    end
    
    -- Cleanup every 5 seconds
    if now - LastCleanup > 5 then
        LastCleanup = now
        for part, _ in pairs(OriginalSizes) do
            if not part or not part.Parent then
                restorePart(part)
            end
        end
    end
end

-- =====================================
-- CONTROL FUNCTIONS
-- =====================================
local function enableHitbox()
    if Enabled then return end
    Enabled = true
    
    -- Expand current players
    for _, player in pairs(Players:GetPlayers()) do
        if isValidTarget(player) and player.Character then
            expandCharacter(player.Character)
        end
    end
    
    -- Main update loop
    Connections.Update = RunService.Heartbeat:Connect(updateAllHitboxes)
    
    -- Player added
    Connections.PlayerAdded = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(character)
            if Enabled and isValidTarget(player) then
                task.wait(0.5)
                expandCharacter(character)
            end
        end)
    end)
    
    -- Existing players character added
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            Connections[player.Name] = player.CharacterAdded:Connect(function(character)
                if Enabled and isValidTarget(player) then
                    task.wait(0.5)
                    expandCharacter(character)
                end
            end)
        end
    end
    
    print("✅ Hitbox Expander ENABLED (25x25x25)")
end

local function disableHitbox()
    if not Enabled then return end
    Enabled = false
    
    -- Disconnect all
    for _, connection in pairs(Connections) do
        pcall(function() connection:Disconnect() end)
    end
    Connections = {}
    
    -- Restore all
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            restoreCharacter(player.Character)
        end
    end
    
    -- Clear
    OriginalSizes = {}
    Visuals = {}
    
    print("❌ Hitbox Expander DISABLED")
end

local function toggleHitbox()
    if Enabled then
        disableHitbox()
    else
        enableHitbox()
    end
    return Enabled
end

