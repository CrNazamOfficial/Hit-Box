local function saveSettings()
    if not _G.SaveData then return end
    pcall(function() writefile("nazam_hitbox_friends.txt", game:GetService("HttpService"):JSONEncode(_G.FriendList)) end)
end

local function loadSettings()
    if not _G.SaveData then return end
    local success, data = pcall(function() return readfile("nazam_hitbox_friends.txt") end)
    if success and data then _G.FriendList = game:GetService("HttpService"):JSONDecode(data) or {} end
end

local function getPlayerByName(name)
    for _, player in pairs(Players:GetPlayers()) do
        if string.lower(player.Name) == string.lower(name) or (player.DisplayName and string.lower(player.DisplayName) == string.lower(name)) then return player end
    end
    return nil
end

local function createSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Volume = 0.5
    sound.Parent = CoreGui
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 2)
end

